<?xml version="1.0" encoding="utf-8"?>
<!--
    P0 FIX: Backup Rules for Android 12+
    
    EXCLUDE all step/race data to prevent "zombie data" after app reset.
    Only allow backup of non-critical user preferences.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- EXCLUDE everything related to race data -->
        <exclude domain="sharedpref" path="pace_legends_race.xml"/>
        <exclude domain="sharedpref" path="step_sync.xml"/>
        <exclude domain="database" path="pace_legends_db"/>
        <exclude domain="database" path="pace_legends_db-shm"/>
        <exclude domain="database" path="pace_legends_db-wal"/>
    </cloud-backup>
    <device-transfer>
        <!-- Same exclusions for device-to-device transfer -->
        <exclude domain="sharedpref" path="pace_legends_race.xml"/>
        <exclude domain="sharedpref" path="step_sync.xml"/>
        <exclude domain="database" path="pace_legends_db"/>
        <exclude domain="database" path="pace_legends_db-shm"/>
        <exclude domain="database" path="pace_legends_db-wal"/>
    </device-transfer>
</data-extraction-rules>
